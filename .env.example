# Salin file ini menjadi .env di server
# cp .env.example .env

# Port backend (harus sama dengan proxy_pass di nginx)
PORT=3002

# Set production agar Express melayani static frontend
NODE_ENV=production

# Koneksi PostgreSQL (wajib di production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://kasir_user:kasir_pass123@localhost:5432/kasir_online

# Aktifkan SSL untuk koneksi PostgreSQL (opsional, untuk cloud DB)
DATABASE_SSL=false
