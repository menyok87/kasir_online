# Salin file ini menjadi .env di server
# cp .env.example .env

# Port backend (harus sama dengan proxy_pass di nginx)
PORT=3002

# Set production agar Express melayani static frontend
NODE_ENV=production

# JWT Secret (ganti dengan string acak yang panjang di production)
JWT_SECRET=ganti-dengan-secret-key-yang-aman-dan-panjang

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=keuangan_personal
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_database_anda

# URL aplikasi (digunakan untuk link verifikasi email)
APP_URL=https://kasir.keuangan99.com

# SMTP Email via Resend (resend.com) — gratis 3.000 email/bulan
# Daftar di resend.com → Domains → verifikasi domain → API Keys → salin key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM="Kasir Online <noreply@keuangan99.com>"
