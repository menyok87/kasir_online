# Salin file ini menjadi .env di server
# cp .env.example .env

# Port backend (harus sama dengan proxy_pass di nginx)
PORT=3002

# Set production agar Express melayani static frontend
NODE_ENV=production

# JWT Secret (ganti dengan string acak yang panjang di production)
JWT_SECRET=ganti-dengan-secret-key-yang-aman-dan-panjang

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=keuangan_personal
DB_USER=postgres
DB_PASSWORD=MNXfamilyTeam@123

# URL aplikasi (digunakan untuk link verifikasi email)
APP_URL=https://kasir.keuangan99.com

# SMTP Email (opsional — jika dikosongkan, verifikasi email dilewati)
# Gmail: aktifkan "App Password" di https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=emailanda@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM="Kasir Online <emailanda@gmail.com>"
